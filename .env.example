# Copy to .env (never commit .env) and export the values into your shell before starting the app.
# Spring Boot does NOT read .env files by itself; see README "Configuration".

# Profile: h2 (default, in-memory) or mysql
SPRING_PROFILES_ACTIVE=h2

# Initial administrator (created on first startup only if it does not exist yet).
# Use a strong password of at least 12 characters. Do not reuse real passwords.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-random-passphrase
BOOTSTRAP_ADMIN_FULL_NAME=Local Administrator

# MySQL profile only
DB_URL=jdbc:mysql://localhost:3306/ccbilling?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=ccbilling
DB_PASSWORD=replace-with-your-local-mysql-password
# Set to classpath:db/migration to skip the MySQL-only append-only triggers
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/migration-mysql

# Optional
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
# H2 file persistence instead of in-memory (data/ is git-ignored):
# H2_URL=jdbc:h2:file:./data/ccbilling;MODE=MySQL
